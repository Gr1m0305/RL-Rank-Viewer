<Window x:Class="RLOverlay.App.Views.TrackerLobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lobby on tracker.gg"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Icon="pack://application:,,,/RLOverlay;component/Assets/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="TeamHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,6,0,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="14,10,14,10">
        <DockPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock x:Name="HintText" DockPanel.Dock="Right" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Margin="24,0,0,0" TextWrapping="NoWrap" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Lobby on tracker.gg" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="·" FontSize="15" Margin="8,0" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                <TextBlock x:Name="PlaylistText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,4,2,6" Width="520"
                   Visibility="Collapsed" />

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <!-- Rows are placed with Grid.Row (never re-parented) so a player's page isn't reloaded when they change team. -->
            <Grid x:Name="RowsHost" />
        </ScrollViewer>
    </DockPanel>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:RLOverlay.App.Views"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Typography. UiFont is swapped for the bundled Inter in Part 5. -->
    <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

    <!-- Palette -->
    <Color x:Key="AccentBlueColor">#2F8CFF</Color>
    <Color x:Key="AccentOrangeColor">#FF8A1F</Color>
    <SolidColorBrush x:Key="AccentBlue" Color="{StaticResource AccentBlueColor}" />
    <SolidColorBrush x:Key="AccentOrange" Color="{StaticResource AccentOrangeColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F5F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A3ABB8" />
    <SolidColorBrush x:Key="TextMuted" Color="#6E7787" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4F5766" />
    <SolidColorBrush x:Key="WinGreen" Color="#3BD07A" />
    <SolidColorBrush x:Key="LossRed" Color="#F0474D" />
    <SolidColorBrush x:Key="WaitingYellow" Color="#F5C518" />

    <!-- Dark translucent glass -->
    <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE14171E" Offset="0" />
        <GradientStop Color="#EA0E1016" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PanelBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="TeamBackground" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="RowDivider" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="HeaderDivider" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="KeyCapBackground" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="KeyCapBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BadgeBorder" Color="#3DFFFFFF" />
    <LinearGradientBrush x:Key="AppBadgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F8CFF" Offset="0" />
        <GradientStop Color="#FF8A1F" Offset="1" />
    </LinearGradientBrush>

    <!-- Converters -->
    <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <v:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />
    <v:TrackingConverter x:Key="Tracking" />
    <v:StreakBrushConverter x:Key="StreakBrush"
                            Win="{StaticResource WinGreen}"
                            Loss="{StaticResource LossRed}"
                            Neutral="{StaticResource TextPrimary}" />

    <!-- Layout constants (DIPs at 100 % scale) -->
    <GridLength x:Key="IconColumn">34</GridLength>
    <GridLength x:Key="IconGap">10</GridLength>
    <GridLength x:Key="NameColumn">214</GridLength>
    <GridLength x:Key="MmrColumn">66</GridLength>
    <sys:Double x:Key="StatWidth">64</sys:Double>

    <!-- Number cell with loading bar -->
    <Style TargetType="{x:Type v:StatCell}">
        <Setter Property="Width" Value="{StaticResource StatWidth}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type v:StatCell}">
                    <Grid>
                        <TextBlock x:Name="Value"
                                   Text="{TemplateBinding Text}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   TextAlignment="Right"
                                   VerticalAlignment="Center"
                                   Typography.NumeralAlignment="Tabular"
                                   Typography.NumeralStyle="Lining" />
                        <v:SkeletonBar x:Name="Bar"
                                       Width="{TemplateBinding BarWidth}"
                                       Height="9"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Value" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Column header text -->
    <Style x:Key="ColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Width" Value="{StaticResource StatWidth}" />
    </Style>

    <!-- Key cap (Ctrl, G, …) -->
    <DataTemplate x:Key="KeyCapTemplate">
        <Border Background="{StaticResource KeyCapBackground}"
                BorderBrush="{StaticResource KeyCapBorder}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="5,0,5,1"
                Margin="0,0,3,0"
                MinWidth="17">
            <TextBlock Text="{Binding}"
                       FontSize="10.5"
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center" />
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>
</ResourceDictionary>

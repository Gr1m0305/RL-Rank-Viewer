<UserControl x:Class="RLOverlay.App.Views.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:v="clr-namespace:RLOverlay.App.Views"
             xmlns:vm="clr-namespace:RLOverlay.App.ViewModels"
             xmlns:ov="clr-namespace:RLOverlay.App.Overlay"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PanelViewModel}"
             FontFamily="{StaticResource UiFont}"
             Foreground="{StaticResource TextPrimary}"
             Focusable="False">

    <UserControl.Resources>
        <!-- One player row (or an empty seat). Columns: icon | gap | name | MMR | stats. -->
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:PlayerRowViewModel}">
            <Border BorderBrush="{StaticResource RowDivider}" BorderThickness="0,1,0,0" Height="40">
                <Border.RenderTransform>
                    <TranslateTransform X="0" />
                </Border.RenderTransform>
                <!-- A player who joins slides into the row from the left. -->
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                 From="-14" To="0" Duration="0:0:0.36">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource IconColumn}" />
                        <ColumnDefinition Width="{StaticResource IconGap}" />
                        <ColumnDefinition Width="{StaticResource NameColumn}" />
                        <ColumnDefinition Width="{StaticResource MmrColumn}" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Rank icon only (no rank text). -->
                    <Image x:Name="Icon"
                           Source="{Binding RankIcon}"
                           Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5"
                           Visibility="{Binding IsSkeleton, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <v:SkeletonBar Width="28" Height="28" CornerRadius="7"
                                   Visibility="{Binding IsSkeleton, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding Name, Converter={StaticResource NotEmptyToVisibility}}">
                            <!-- The only part of the overlay that takes the mouse. -->
                            <Border x:Name="NameHit"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    ov:OverlayHit.IsInteractive="{Binding CanOpenProfile}"
                                    MouseLeftButtonUp="OnNameClicked">
                                <TextBlock x:Name="NameText"
                                           Text="{Binding Name}"
                                           FontSize="14.5"
                                           FontWeight="SemiBold"
                                           MaxWidth="138"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                            <Border BorderBrush="{StaticResource BadgeBorder}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0,4,1"
                                    Margin="7,1,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Badge, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding Badge, Converter={StaticResource Tracking}}"
                                           FontSize="8.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondary}" />
                            </Border>
                            <TextBlock x:Name="LinkArrow"
                                       Text="↗"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondary}"
                                       Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,1,0,0"
                                    Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVisibility}}">
                            <Ellipse Width="5" Height="5" Margin="0,1,6,0"
                                     Fill="{StaticResource WaitingYellow}"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IsSkeleton, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11.5"
                                       FontStyle="Italic"
                                       Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <v:StatCell Grid.Column="3"
                                Width="66"
                                Text="{Binding Mmr}"
                                IsLoading="{Binding IsSkeleton}"
                                BarWidth="52"
                                FontSize="16.5"
                                FontWeight="Bold" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <v:StatCell Text="{Binding Wins}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Wins, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Streak}" IsLoading="{Binding IsSkeleton}"
                                    Foreground="{Binding StreakKind, Converter={StaticResource StreakBrush}}"
                                    FontWeight="SemiBold"
                                    Visibility="{Binding DataContext.Columns.Streak, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Peak}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Peak, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Goals}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Goals, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Shots}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Shots, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Assists}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Assists, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Saves}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Saves, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        <v:StatCell Text="{Binding Mvps}" IsLoading="{Binding IsSkeleton}"
                                    Visibility="{Binding DataContext.Columns.Mvps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Path=(ov:OverlayHit.IsHovered), ElementName=NameHit}" Value="True">
                    <Setter TargetName="NameText" Property="TextDecorations" Value="Underline" />
                    <Setter TargetName="LinkArrow" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="NoData">
                    <Setter TargetName="NameText" Property="Foreground" Value="{StaticResource TextSecondary}" />
                </DataTrigger>
                <!-- When the lookup finishes the rank icon pops in (springy scale + fade). -->
                <DataTrigger Binding="{Binding IsSkeleton}" Value="True">
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.22" />
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.4" To="1" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.55" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.4" To="1" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction>
                                        <BackEase EasingMode="EaseOut" Amplitude="0.55" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Team block: accent edge, name + count, column headers, rows. -->
        <DataTemplate DataType="{x:Type vm:TeamViewModel}">
            <Border x:Name="Block"
                    CornerRadius="8"
                    Background="{StaticResource TeamBackground}"
                    BorderBrush="{StaticResource AccentBlue}"
                    BorderThickness="3,0,0,0">
                <StackPanel Margin="12,7,14,3">
                    <Grid>
                        <TextBlock x:Name="TeamLabel"
                                   Text="{Binding Label, Converter={StaticResource Tracking}}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBlue}" />
                        <TextBlock Text="{Binding CountText}"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,8,0"
                                   FontSize="10.5"
                                   Foreground="{StaticResource TextSecondary}"
                                   Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource IconColumn}" />
                            <ColumnDefinition Width="{StaticResource IconGap}" />
                            <ColumnDefinition Width="{StaticResource NameColumn}" />
                            <ColumnDefinition Width="{StaticResource MmrColumn}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="3" Width="66" Style="{StaticResource ColumnHeader}"
                                   Text="{Binding Source=MMR, Converter={StaticResource Tracking}}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=WINS, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Wins, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=STREAK, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Streak, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=PEAK, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Peak, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=GOALS, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Goals, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=SHOTS, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Shots, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=AST, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Assists, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=SAVES, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Saves, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource ColumnHeader}" Text="{Binding Source=MVP, Converter={StaticResource Tracking}}"
                                       Visibility="{Binding DataContext.Columns.Mvps, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}"
                                  ItemTemplate="{StaticResource RowTemplate}"
                                  Focusable="False" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOrange}" Value="True">
                    <Setter TargetName="Block" Property="BorderBrush" Value="{StaticResource AccentOrange}" />
                    <Setter TargetName="TeamLabel" Property="Foreground" Value="{StaticResource AccentOrange}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Soft shadow on its own layer so text is not rendered through an effect. -->
        <Border CornerRadius="12" Background="#FF0A0C10" Margin="3">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="12"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1"
                Padding="14,11,14,10">
            <StackPanel>
                <!-- Header: app badge, playlist title, subtitle; hotkey hints on the right. -->
                <DockPanel x:Name="HeaderRow" Margin="1,0,0,9">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ItemsControl ItemsSource="{Binding CycleKeys}"
                                      ItemTemplate="{StaticResource KeyCapTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      Focusable="False" />
                        <TextBlock Text="Playlist" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="1,0,10,0" />
                        <ItemsControl ItemsSource="{Binding ToggleKeys}"
                                      ItemTemplate="{StaticResource KeyCapTemplate}"
                                      ItemsPanel="{StaticResource HorizontalPanel}"
                                      Focusable="False" />
                        <TextBlock Text="Hide" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="1,0,0,0" />
                    </StackPanel>
                    <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AppBadgeBrush}" VerticalAlignment="Center">
                        <TextBlock Text="R" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextSecondary}"
                               Margin="8,2,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <ContentControl x:Name="BlueHost" Content="{Binding Blue}" Focusable="False" />
                <ContentControl x:Name="OrangeHost" Content="{Binding Orange}" Focusable="False" Margin="0,8,0,0" />

                <DockPanel x:Name="FooterRow" Margin="1,8,1,0">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding FooterRight}" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="16,0,0,0" />
                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center"
                             Fill="{StaticResource WaitingYellow}"
                             Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding FooterLeft}" FontSize="11" Foreground="{StaticResource TextMuted}"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

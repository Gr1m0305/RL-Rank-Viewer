<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 1809+: the tracker.gg lobby window's WebView2CompositionControl needs the Windows SDK projection. -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RLOverlay</AssemblyName>
    <RootNamespace>RLOverlay.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Required by the LibraryImport source generator in Native/. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFAC010 is a WinForms-only DPI hint; this is a WPF app whose DPI mode lives in app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WPF + WinForms (tray icon only): keep WinForms types out of the implicit usings to avoid name clashes. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RLOverlay.Core\RLOverlay.Core.csproj" />
  </ItemGroup>

  <!-- The demo lobby for the demo flag (same file the tests and FakeStatsServer use). The two text files are also
       embedded so the installer can write them next to the installed exe. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\Inter-OFL.txt" LogicalName="RLOverlay.Licenses.Inter-OFL.txt" />
    <EmbeddedResource Include="..\..\assets\ranks\README.md" LogicalName="RLOverlay.Assets.Ranks.README.md" Link="Resources\ranks-README.md" />
    <EmbeddedResource Include="..\..\tests\fixtures\scenarios\demo_lobby.json" Link="Scenarios\demo_lobby.json" LogicalName="RLOverlay.Scenarios.demo_lobby.json" />
  </ItemGroup>

  <!-- Bundled font (OFL): compiled in as WPF resources; the licence ships next to the exe. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\Inter-*.ttf" />
    <!-- App icon (generated by tools/icon/make_icon.ps1): exe icon, window icons, tray icon. -->
    <Resource Include="Assets\app.ico" />
    <None Include="Assets\Fonts\Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="licenses\Inter-OFL.txt" />
    <!-- Tells users which rank icon file names to drop in (no artwork ships with the app). -->
    <None Include="..\..\assets\ranks\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Link="assets\ranks\README.md" />
  </ItemGroup>

  <!-- The installer is this same single-file exe under a setup name: a file name containing "setup" starts setup mode. -->
  <Target Name="CopySetupExe" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)Gr1msRLOverlay-Setup.exe" />
    <Message Importance="high" Text="Setup: $(PublishDir)Gr1msRLOverlay-Setup.exe" />
  </Target>

</Project>

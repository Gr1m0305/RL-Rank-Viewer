<Window x:Class="RLOverlay.App.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:s="clr-namespace:RLOverlay.App.Setup"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=s:SetupViewModel}"
        Title="{Binding Title}"
        Width="580" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/RLOverlay;component/Assets/app.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RLOverlay;component/Views/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="26,22,26,22">
            <!-- Header -->
            <DockPanel>
                <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource AppBadgeBrush}" VerticalAlignment="Center">
                    <TextBlock Text="R" FontSize="21" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Options: install / update -->
            <StackPanel Visibility="{Binding IsOptions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Visibility="{Binding IsUninstall, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,18,0,0" LineHeight="19"
                               Text="Everyone's rank, MMR and stats when you load into a Rocket League match. It never touches the game process, so it is safe with Easy Anti-Cheat." />

                    <TextBlock Text="INSTALL LOCATION" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Change…" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0"
                                        Command="{Binding ChangeFolderCommand}" IsEnabled="{Binding CanChangeFolder}" />
                                <TextBlock Text="{Binding TargetDir}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding TargetDir}" />
                            </DockPanel>
                            <TextBlock Text="{Binding FolderHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="OPTIONS" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="Start with Windows">
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" FontSize="13.5" />
                                    <TextBlock Text="Recommended. It waits quietly in the notification area and switches on by itself whenever you open Rocket League."
                                               Style="{StaticResource Hint}" />
                                </StackPanel>
                            </CheckBox>
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DesktopShortcut}" AutomationProperties.Name="Desktop shortcut">
                                <TextBlock Text="Add a desktop shortcut" FontSize="13.5" />
                            </CheckBox>
                            <Border Style="{StaticResource Divider}" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LaunchWhenDone}" AutomationProperties.Name="Open when done">
                                <TextBlock Text="Open it when setup finishes" FontSize="13.5" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Options: uninstall -->
                <StackPanel Visibility="{Binding IsUninstall, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,18,0,0" LineHeight="19"
                               Text="This removes the app, its shortcuts and the Start with Windows entry. If it is running, it is closed first." />
                    <TextBlock Text="YOUR DATA" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RemoveUserData}" AutomationProperties.Name="Delete my settings">
                            <StackPanel>
                                <TextBlock Text="Also delete my settings, logs and downloaded rank icons" FontSize="13.5" />
                                <TextBlock Text="Leave this off to keep them for a later install (they are in %LOCALAPPDATA%\RLOverlay)." Style="{StaticResource Hint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Working -->
            <StackPanel Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" Margin="0,34,0,22">
                <TextBlock Text="{Binding Status}" FontSize="14" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" BorderThickness="0"
                             Foreground="{StaticResource AccentBlue}" Background="{StaticResource CardBackground}" />
            </StackPanel>

            <!-- Done -->
            <DockPanel Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" Margin="0,26,0,8">
                <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Top" Margin="0,2,14,0">
                    <Ellipse Fill="{StaticResource WinGreen}" Opacity="0.18" />
                    <Path Data="M 10,17.5 L 15,22.5 L 24.5,12" Stroke="{StaticResource WinGreen}" StrokeThickness="2.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Grid>
                <StackPanel>
                    <TextBlock Text="{Binding DoneTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DoneText}" Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="19"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Failed -->
            <DockPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}" Margin="0,26,0,8">
                <Grid DockPanel.Dock="Left" Width="34" Height="34" VerticalAlignment="Top" Margin="0,2,14,0">
                    <Ellipse Fill="{StaticResource LossRed}" Opacity="0.18" />
                    <TextBlock Text="!" FontSize="19" FontWeight="Bold" Foreground="{StaticResource LossRed}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel>
                    <TextBlock Text="That didn't work" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource TextSecondary}" FontSize="13" LineHeight="19"
                               TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="26,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsOptions, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{Binding ActionLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                            IsDefault="True" Margin="10,0,0,0" MinWidth="96" />
                </StackPanel>
                <Button Content="Finish" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" MinWidth="96"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                    <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                    <Button Content="Try again" Style="{StaticResource PrimaryButton}" Command="{Binding TryAgainCommand}" Margin="10,0,0,0"
                            Visibility="{Binding CanTryAgain, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>

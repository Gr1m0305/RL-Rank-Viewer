<?xml version="1.0" encoding="utf-8"?>
<!--
  One self-contained exe for 64-bit Windows (no .NET install needed on the target PC), written to publish/ at the
  repository root:  dotnet publish src/RLOverlay.App -c Release -p:PublishProfile=SingleFile
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native libraries go inside the exe too and are unpacked on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
